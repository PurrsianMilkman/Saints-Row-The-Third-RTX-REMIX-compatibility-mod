     RTX_OPTION_ARGS("rtx", float, uniqueObjectDistance, 300.f, "The distance (in game units) that an object can move in a single frame before it is no longer considered the same object.\n"
                     "If this is too low, fast moving objects may flicker and have bad lighting.  If it's too high, repeated objects may flicker.\n"
                     "This does not account for sceneScale.", args.minValue = 0.f);
+
+    RTX_OPTION("rtx", bool, drawCallCacheRequireShapeMatch, true,
+      "When true, a cached BlasEntry may only be reused on a material-hash match if the incoming draw has the same vertex and index counts and a world centroid within "
+      "uniqueObjectDistance. Prevents a game that rebuilds batched geometry into a recycled dynamic buffer from inheriting another batch's previous-frame positions, which "
+      "produces stretched geometry via bogus motion vectors (measured on Saints Row: The Third's world decal batching - see the shapeMatches() comment in "
+      "rtx_draw_call_cache.cpp). Set false to restore the original upstream behaviour, where a material-hash match alone was sufficient to reuse a BlasEntry.");
     
+    RTX_OPTION("rtx", bool, instanceHistoryRequiresPriorFrame, true,
+      "When true, an instance created this frame does not use the previous-frame vertex positions held by its BlasEntry. "
+      "A BlasEntry is shared between instances and outlives them, so a newly created instance would otherwise compute its "
+      "motion vectors against another object's previous positions (or its own from before it was unloaded), smearing the "
+      "geometry across the screen for one frame - visible in games that stream geometry in and out. Remix already applies "
+      "the equivalent rule to the transform via RtInstance::teleport(); this extends it to vertex positions. "
+      "Set false to restore the original upstream behaviour.");
+
     RTX_OPTION("rtx", bool, useNewGuiInputMethod, true, "Disables the previous method for getting mouse/keyboard input and enables a new method which should be more reliable.  If successful the old method will be deprecated.  This setting can't be changed at runtime, so it must be set in a .conf file.");
 
     RTX_OPTION_ARGS("rtx", UIType, showUI, UIType::None, "0 = Don't Show, 1 = Show Simple, 2 = Show Advanced.",
