diff --git a/src/dxvk/rtx_render/rtx_instance_manager.cpp b/src/dxvk/rtx_render/rtx_instance_manager.cpp
index 92e11909..0aac4214 100644
--- a/src/dxvk/rtx_render/rtx_instance_manager.cpp
+++ b/src/dxvk/rtx_render/rtx_instance_manager.cpp
@@ -1133,9 +1133,30 @@ namespace dxvk {
                                    || currentInstance.testCategoryFlags(InstanceCategories::Particle)
                                    || currentInstance.testCategoryFlags(InstanceCategories::WorldUI);
 
-        hasPreviousPositions = blas.modifiedGeometryData.previousPositionBuffer.defined() && !isMotionUnstable;
         const bool isFirstUpdateAfterCreation = currentInstance.isCreatedThisFrame(m_device->getCurrentFrameId()) && isFirstUpdateThisFrame;
 
+        // An instance that was CREATED THIS FRAME has no previous frame, so it has no valid
+        // previous VERTEX POSITIONS either - and previousPositionBuffer is owned by the BLAS,
+        // not by this instance. A BlasEntry routinely outlives and is shared between instances
+        // (SceneManager::garbageCollection only erases entries with no linked instances, and
+        // DrawCallCache hands an existing entry to whatever draw matches it), so a brand-new
+        // instance attaching to an existing entry would otherwise inherit previous-frame
+        // positions belonging to a DIFFERENT object, or to itself from before it was unloaded.
+        // The surface is then marked non-static below and the motion vector is computed from
+        // those foreign positions, smearing the geometry across the screen for exactly one frame.
+        //
+        // Measured in SR3: the user sees decals "stretch for a frame" precisely when they "load,
+        // unload or reload" - i.e. on instance creation - and it survived a DrawCallCache-side
+        // fix, because the entry being reused can be perfectly legitimate; it is the INSTANCE
+        // that is new.
+        //
+        // Remix already does exactly this for the TRANSFORM half of the motion vector: the
+        // isFirstUpdateAfterCreation branch below calls teleport(), which sets prevObjectToWorld
+        // = objectToWorld so a new instance reports zero transform motion. This applies the same
+        // rule to the vertex half, which was simply missed.
+        hasPreviousPositions = blas.modifiedGeometryData.previousPositionBuffer.defined() && !isMotionUnstable
+                            && !(RtxOptions::instanceHistoryRequiresPriorFrame() && isFirstUpdateAfterCreation);
+
         // Note: objectToView is aliased on updates, since findSimilarInstance() doesn't discern it
         Matrix4 objectToWorld = drawCall.getTransformData().objectToWorld;
 
